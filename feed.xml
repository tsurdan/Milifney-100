---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html" hreflang="he"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <author>
    <name>{{ site.title }}</name>
  </author>
  {% for post in site.posts limit:30 %}
  {% assign real_date_str = post.path | split: "/" | last | truncate: 10, "" %}
  {% assign feed_summary = post.standfirst | default: post.content | strip_html | strip_newlines | truncate: 200 %}
  <entry>
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <published>{{ real_date_str }}T12:00:00+03:00</published>
    <updated>{{ real_date_str }}T12:00:00+03:00</updated>
    <id>{{ post.url | absolute_url }}</id>
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | xml_escape }}</content>
    <summary type="html">{{ feed_summary | xml_escape }}</summary>
    {% if post.image %}<link rel="enclosure" type="image/jpeg" href="{{ post.image | absolute_url }}"/>{% endif %}
  </entry>
  {% endfor %}
</feed>
