---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">
  {% for post in site.posts limit:50 %}
  {% assign filename_date = post.path | split: "/" | last | truncate: 10, "" %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <news:news>
      <news:publication>
        <news:name>חדשות מלפני מאה</news:name>
        <news:language>he</news:language>
      </news:publication>
      <news:publication_date>{{ filename_date }}T12:00:00+03:00</news:publication_date>
      <news:title>{{ post.title | xml_escape }}</news:title>
    </news:news>
  </url>
  {% endfor %}
</urlset>
