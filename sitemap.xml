---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
{% comment %}Split by page type so Search Console reports indexing per type.{% endcomment %}
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_files = "sitemap-pages.xml,sitemap-hubs.xml,sitemap-archive.xml,sitemap-posts.xml" | split: "," %}
  {% for f in sitemap_files %}<sitemap>
    <loc>{{ '/' | append: f | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
  </sitemap>
  {% endfor %}
</sitemapindex>