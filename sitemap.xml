---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    <lastmod>{{ site.time | date_to_xmlschema }}</lastmod>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ '/popular' | absolute_url }}</loc>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>{{ '/about' | absolute_url }}</loc>
    <priority>0.5</priority>
  </url>
  <url>
    <loc>{{ '/support' | absolute_url }}</loc>
    <priority>0.4</priority>
  </url>
  <url>
    <loc>{{ '/search' | absolute_url }}</loc>
    <priority>0.5</priority>
  </url>
  {% for post in site.posts %}{% assign real_date_str = post.path | split: "/" | last | truncate: 10, "" %}<url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ real_date_str }}T12:00:00+03:00</lastmod>
    <priority>0.8</priority>
  </url>
  {% endfor %}
</urlset>
